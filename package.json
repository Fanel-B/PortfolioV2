    "next": "^13.4.6",
    "next-themes": "0.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "4.6.0",
    "sharp": "0.31.3"
  },
  "devDependencies": {
    "@types/node": "18.11.18",
    "@types/react": "18.2.8",
    "@typescript-eslint/eslint-plugin": "5.40.1",
    "@typescript-eslint/parser": "5.40.1",
    "autoprefixer": "10.4.13",
    "eslint": "8.31.0",
    "eslint-config-next": "^13.4.6",
    "eslint-config-prettier": "8.6.0",
    "eslint-plugin-jsx-a11y": "6.6.1",
    "eslint-plugin-prettier": "4.2.1",
    "husky": "8.0.3",
    "lint-staged": "13.1.0",
